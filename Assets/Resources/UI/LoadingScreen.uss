/* ========================================================
   PAMAHIIN - PERSISTENT INTERMISSION LOADING SCREEN
   Aged Horror Dossier / Gunmetal / Brass Aesthetic
   ======================================================== */
@import url("PamahiinTheme.uss");

/* ==========================================================================
   LOADING SCREEN - 16-BIT FOLK-HORROR PIXEL FRAME
   ========================================================================== */

.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(7, 8, 12);
    background-color: rgb(6, 5, 9);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.loading-visible {
    opacity: 1;
}

.hidden {
    display: none;
}

.loading-vignette {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-width: 28px;
    border-color: rgba(2, 2, 4, 0.85);
    background-color: rgba(18, 10, 10, 0.18);
    border-width: 16px;
    border-color: rgba(3, 2, 5, 0.94);
    background-color: rgba(18, 8, 10, 0.24);
}

.loading-frame {
    width: 680px;
    max-width: 88%;
    background-color: rgba(16, 15, 20, 0.96);
    border-width: 2px;
    border-color: rgb(118, 88, 52);
    border-radius: 6px;
    padding: 30px 36px;
    max-width: 90%;
    background-color: var(--pm-bg-panel);
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    padding: 26px 32px;
    align-items: stretch;
}

.loading-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    margin-bottom: 12px;
}

.loading-tag {
    font-size: 12px;
    color: rgb(196, 154, 86);
    -unity-font-style: bold;
    letter-spacing: 3px;
    font-size: 9px;
    color: var(--pm-accent-brass);
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.loading-percent {
    font-size: 13px;
    color: rgb(215, 202, 178);
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--pm-text-primary);
    -unity-font-style: normal;
    letter-spacing: 1px;
}

.loading-divider {
    height: 2px;
    background-color: rgba(145, 42, 36, 0.8);
    margin-bottom: 22px;
    background-color: var(--pm-accent-crimson);
    border-bottom-width: 1px;
    border-bottom-color: var(--pm-border-brass-lo);
    margin-bottom: 20px;
}

.loading-title {
    font-size: 28px;
    color: rgb(242, 232, 214);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
    font-size: 16px;
    color: var(--pm-text-primary);
    -unity-font-style: normal;
    letter-spacing: 2px;
    line-height: 24px;
    margin-bottom: 10px;
    white-space: normal;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

.loading-subtitle {
    font-size: 15px;
    color: rgb(186, 172, 152);
    font-size: 10px;
    color: var(--pm-text-muted);
    letter-spacing: 1px;
    margin-bottom: 26px;
    line-height: 16px;
    margin-bottom: 22px;
    white-space: normal;
}

.loading-progress-section {
    margin-bottom: 24px;
    margin-bottom: 20px;
}

.loading-progress-track {
    width: 100%;
    height: 14px;
    background-color: rgb(10, 11, 15);
    height: 16px;
    background-color: var(--pm-bg-void);
    border-width: 2px;
    border-color: rgb(88, 68, 44);
    border-radius: 2px;
    border-top-color: var(--pm-border-brass-lo);
    border-left-color: var(--pm-border-brass-lo);
    border-right-color: var(--pm-border-brass);
    border-bottom-color: var(--pm-border-brass);
    border-radius: 0px;
    padding: 2px;
    overflow: hidden;
    margin-bottom: 8px;
}

.loading-progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(172, 42, 34);
    background-color: var(--pm-accent-crimson);
    border-right-width: 3px;
    border-right-color: rgb(235, 178, 92);
    border-right-color: var(--pm-border-brass-hi);
}

.loading-status {
    font-size: 12px;
    color: rgb(146, 140, 132);
    font-size: 9px;
    color: var(--pm-text-muted);
    letter-spacing: 1px;
    line-height: 14px;
    white-space: normal;
}

.loading-tip-card {
    background-color: rgba(26, 22, 20, 0.92);
    border-width: 1px;
    border-color: rgba(118, 88, 52, 0.65);
    border-left-width: 3px;
    border-left-color: rgb(178, 140, 62);
    background-color: var(--pm-bg-deep);
    border-width: 2px;
    border-color: var(--pm-border-dim);
    border-left-width: 4px;
    border-left-color: var(--pm-accent-brass);
    border-radius: 0px;
    padding: 12px 16px;
}

.loading-tip-header {
    font-size: 11px;
    color: rgb(196, 154, 86);
    -unity-font-style: bold;
    font-size: 9px;
    color: var(--pm-accent-brass);
    -unity-font-style: normal;
    letter-spacing: 2px;
    margin-bottom: 4px;
    margin-bottom: 6px;
}

.loading-tip {
    font-size: 13px;
    color: rgb(218, 206, 186);
    font-size: 10px;
    color: var(--pm-text-primary);
    line-height: 16px;
    white-space: normal;
}
