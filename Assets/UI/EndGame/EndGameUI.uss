.overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
}

.hidden {
    display: none;
}

.reveal-container {
    width: 600px;
    align-items: stretch;
}

.main-title {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    letter-spacing: 5px;
}

.result-box {
    background-color: rgb(20, 20, 20);
    padding: 20px;
    border-width: 2px;
    border-color: rgb(100, 20, 20);
    margin-bottom: 20px;
    align-items: center;
}

.sub-title {
    font-size: 18px;
    color: rgb(200, 200, 200);
    margin-bottom: 10px;
}

.true-ghost-label {
    font-size: 48px;
    color: rgb(255, 50, 50);
    -unity-font-style: bold;
}

.guess-box {
    background-color: rgb(30, 30, 30);
    padding: 15px;
    margin-bottom: 40px;
    align-items: center;
    flex-direction: row;
    justify-content: space-around;
}

.small-title {
    font-size: 16px;
    color: rgb(150, 150, 150);
}

.guess-label {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
}

.status-label {
    font-size: 24px;
    -unity-font-style: bold;
}

.success {
    color: rgb(50, 255, 50);
}

.failure {
    color: rgb(255, 50, 50);
}

.return-button {
    font-size: 20px;
    padding: 15px;
    background-color: rgb(40, 40, 40);
    color: white;
}

.return-button:hover {
    background-color: rgb(80, 80, 80);
}
