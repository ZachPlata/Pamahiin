/* ═══════════════════════════════════════════════════════════
   PauseMenu.uss  –  Pamahiin in-game pause / settings UI
   ═══════════════════════════════════════════════════════════ */

/* ── Shared ─────────────────────────────────────────────── */
.overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.78);
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
}

.hidden {
    display: none;
}

/* ── Menu Container ─────────────────────────────────────── */
.menu-container {
    background-color: rgb(12, 12, 18);
    border-width: 1px;
    border-color: rgb(60, 60, 80);
    border-radius: 6px;
    padding: 28px 32px 32px 32px;
    width: 360px;
    align-items: stretch;
}

/* ── Title ──────────────────────────────────────────────── */
.title-label {
    font-size: 32px;
    color: rgb(220, 50, 50);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    letter-spacing: 4px;
}

/* ── Section Divider Label ──────────────────────────────── */
.section-label {
    font-size: 11px;
    color: rgb(140, 100, 100);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-top: 16px;
    margin-bottom: 4px;
    letter-spacing: 3px;
    border-bottom-width: 1px;
    border-color: rgb(60, 40, 40);
    padding-bottom: 4px;
}

/* ── Buttons ────────────────────────────────────────────── */
.button-container {
    align-items: stretch;
}

.menu-button {
    margin-top: 7px;
    margin-bottom: 7px;
    padding-top: 13px;
    padding-bottom: 13px;
    font-size: 17px;
    background-color: rgb(28, 28, 38);
    color: rgb(230, 230, 230);
    border-width: 0;
    border-radius: 4px;
    transition-duration: 0.15s;
}

.menu-button:hover {
    background-color: rgb(55, 55, 75);
    scale: 1.03;
}

.menu-button:active {
    background-color: rgb(180, 40, 40);
}

.btn-danger {
    color: rgb(255, 100, 100);
}

.btn-danger:hover {
    background-color: rgb(90, 20, 20);
}

.back-button {
    margin-top: 18px;
    font-size: 15px;
    color: rgb(160, 160, 160);
    background-color: rgb(22, 22, 30);
}

/* ── Slider Row ─────────────────────────────────────────── */
.slider-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.slider-label {
    width: 56px;
    font-size: 13px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-left;
}

.setting-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

.slider-value {
    width: 40px;
    font-size: 12px;
    color: rgb(180, 180, 180);
    -unity-text-align: middle-right;
}

/* ── Toggle Row ─────────────────────────────────────────── */
.toggle-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.setting-toggle {
    margin-left: auto;
}

.toggle-label {
    width: 200px;
}

/* ── Player List ─────────────────────────────────────────── */
.player-scroll {
    max-height: 260px;
    margin-bottom: 6px;
}

.player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 6px;
    border-bottom-width: 1px;
    border-color: rgb(40, 40, 55);
}

.player-row:hover {
    background-color: rgb(28, 28, 45);
}

.player-name {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(220, 220, 220);
}

.player-badge {
    font-size: 11px;
    color: rgb(255, 200, 60);
    margin-right: 8px;
    -unity-font-style: bold;
}

.btn-kick {
    font-size: 12px;
    color: rgb(255, 80, 80);
    background-color: rgb(60, 20, 20);
    border-width: 1px;
    border-color: rgb(120, 30, 30);
    border-radius: 3px;
    padding: 4px 10px;
}

.btn-kick:hover {
    background-color: rgb(100, 25, 25);
}

.btn-vote {
    font-size: 12px;
    color: rgb(255, 160, 60);
    background-color: rgb(55, 40, 10);
    border-width: 1px;
    border-color: rgb(140, 90, 20);
    border-radius: 3px;
    padding: 4px 10px;
    margin-right: 4px;
}

.btn-vote:hover {
    background-color: rgb(90, 60, 10);
}

/* ── FPS Counter (displayed on HUD via C#) ───────────────── */
.fps-label {
    position: absolute;
    top: 6px;
    right: 10px;
    font-size: 13px;
    color: rgb(180, 255, 180);
    -unity-font-style: bold;
}
