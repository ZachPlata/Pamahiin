@import url("project://database/Assets/Resources/UI/PamahiinTheme.uss");

/* ==========================================================================
   PAUSE MENU STYLESHEET - 16-BIT PIXEL OVERLAY
   ========================================================================== */

.overlay {
    flex-grow: 1;
    background-color: rgba(6, 4, 8, 0.84);
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
}

.hidden {
    display: none;
}

/* Central Card Panel */
.menu-container {
    background-color: var(--pm-bg-panel);
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    padding: 28px 32px 30px 32px;
    width: 460px;
    max-width: 92%;
    align-items: stretch;
}

/* Title */
.title-label {
    font-size: 20px;
    color: var(--pm-accent-crimson-hi);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    letter-spacing: 3px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

/* Section subheadings inside Settings */
.section-label {
    font-size: 9px;
    color: var(--pm-accent-brass);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    margin-top: 14px;
    margin-bottom: 6px;
    letter-spacing: 2px;
    border-bottom-width: 2px;
    border-color: var(--pm-border-brass-lo);
    padding-bottom: 4px;
}

/* Buttons */
.button-container {
    align-items: stretch;
}

.menu-button {
    margin-top: 6px;
    margin-bottom: 6px;
    padding: 12px 14px;
    font-size: 11px;
    background-color: var(--pm-bg-elevated);
    color: var(--pm-text-primary);
    border-width: 3px;
    border-top-color: var(--pm-border-brass);
    border-left-color: var(--pm-border-brass);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    -unity-font-style: normal;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

.menu-button:hover {
    background-color: rgb(56, 32, 42);
    color: var(--pm-border-brass-hi);
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
}

.menu-button:active {
    background-color: var(--pm-accent-crimson);
    translate: 0px 2px;
}

.btn-danger {
    color: rgb(255, 196, 196);
    background-color: rgba(88, 18, 24, 0.95);
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
}

.btn-danger:hover {
    background-color: rgba(142, 26, 34, 0.98);
    color: rgb(255, 244, 244);
}

.back-button {
    margin-top: 16px;
    font-size: 10px;
    padding: 10px 14px;
    background-color: var(--pm-bg-deep);
    color: var(--pm-text-muted);
}

/* Sliders */
.slider-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.slider-label {
    width: 108px;
    font-size: 10px;
    color: var(--pm-text-primary);
    -unity-text-align: middle-left;
}

.setting-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

.slider-value {
    width: 54px;
    font-size: 9px;
    color: var(--pm-accent-brass);
    -unity-text-align: middle-right;
}

/* Toggles */
.toggle-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.setting-toggle {
    margin-left: auto;
}

.toggle-label {
    width: 240px;
    font-size: 10px;
}

/* Players panel */
.player-scroll {
    max-height: 260px;
    margin-bottom: 6px;
}

.player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 8px;
    border-bottom-width: 2px;
    border-color: var(--pm-border-dim);
}

.player-row:hover {
    background-color: rgba(42, 30, 38, 0.9);
}

.player-name {
    flex-grow: 1;
    font-size: 10px;
    color: var(--pm-text-primary);
}

.player-badge {
    font-size: 8px;
    color: var(--pm-accent-brass);
    margin-right: 8px;
    -unity-font-style: normal;
}

.btn-kick {
    font-size: 8px;
    color: rgb(255, 200, 200);
    background-color: rgba(84, 18, 24, 0.95);
    border-width: 2px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    padding: 5px 8px;
}

.btn-kick:hover {
    background-color: rgba(138, 28, 36, 0.98);
}

.btn-vote {
    font-size: 8px;
    color: rgb(255, 224, 148);
    background-color: rgba(74, 52, 16, 0.95);
    border-width: 2px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    padding: 5px 8px;
    margin-right: 4px;
}

.btn-vote:hover {
    background-color: rgba(114, 80, 22, 0.98);
}

/* FPS Counter */
.fps-label {
    position: absolute;
    top: 8px;
    right: 12px;
    font-size: 10px;
    color: var(--pm-accent-phosphor);
    -unity-font-style: normal;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.95);
}

/* Help & Controls Panel */
.controls-container {
    width: 600px;
    max-width: 92%;
}

.controls-scroll {
    max-height: 360px;
    margin-bottom: 6px;
    padding-right: 4px;
}

.control-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 6px;
    border-bottom-width: 1px;
    border-color: var(--pm-border-dim);
}

.control-key {
    width: 210px;
    flex-shrink: 0;
    font-size: 9px;
    color: var(--pm-accent-brass);
    -unity-text-align: middle-left;
    padding-right: 10px;
    white-space: normal;
}

.control-desc {
    flex-grow: 1;
    font-size: 9px;
    color: var(--pm-text-primary);
    -unity-text-align: middle-left;
    white-space: normal;
}

.control-tip {
    font-size: 8px;
    color: var(--pm-text-muted);
    margin-top: 6px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

/* ==========================================================================
   HOST DISCONNECTED MODAL OVERLAY
   ========================================================================== */

.host-disconnect-overlay {
    background-color: rgba(6, 4, 8, 0.92);
}

.host-disconnect-panel {
    width: 520px;
    max-width: 92%;
    background-color: rgba(24, 14, 18, 0.98);
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
}

.host-disconnect-tag {
    font-size: 9px;
    color: var(--pm-accent-brass);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.host-disconnect-title {
    font-size: 22px;
    color: var(--pm-accent-crimson-hi);
    margin-bottom: 14px;
    white-space: normal;
}

.host-disconnect-divider {
    height: 2px;
    background-color: var(--pm-border-brass-lo);
    border-top-width: 1px;
    border-top-color: var(--pm-border-brass);
    margin-bottom: 16px;
}

.host-disconnect-desc {
    font-size: 10px;
    line-height: 18px;
    color: var(--pm-text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 22px;
}

.host-disconnect-btn {
    margin-top: 4px;
    margin-bottom: 0px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
}

.host-disconnect-btn:hover {
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    color: rgb(255, 248, 224);
}
