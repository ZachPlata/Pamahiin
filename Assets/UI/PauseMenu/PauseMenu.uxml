<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements" editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <Style src="PauseMenu.uss" />

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--  ROOT OVERLAY                                                       -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <ui:VisualElement name="pause-overlay" class="overlay hidden">

        <!-- ── MAIN PAUSE PANEL ─────────────────────────────────────── -->
        <ui:VisualElement name="panel-main" class="menu-container">
            <ui:Label text="PAUSED" class="title-label" />
            <ui:VisualElement class="button-container">
                <ui:Button name="btn-resume"   text="▶  RESUME"          class="menu-button" />
                <ui:Button name="btn-restart-tutorial" text="RESTART TUTORIAL" class="menu-button hidden" />
                <ui:Button name="btn-skip-tutorial" text="SKIP TUTORIAL" class="menu-button hidden" />
                <ui:Button name="btn-settings" text="SETTINGS"           class="menu-button" />
                <ui:Button name="btn-controls" text="HELP &amp; CONTROLS" class="menu-button" />
                <ui:Button name="btn-players"  text="PLAYERS"            class="menu-button" />
                <ui:Button name="btn-quit"     text="X  QUIT TO MENU"    class="menu-button btn-danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── SETTINGS PANEL ───────────────────────────────────────── -->
        <ui:VisualElement name="panel-settings" class="menu-container hidden">
            <ui:Label text="SETTINGS" class="title-label" />

            <!-- AUDIO -->
            <ui:Label text="AUDIO" class="section-label" />

            <ui:VisualElement class="slider-row">
                <ui:Label text="Master"  class="slider-label" />
                <ui:Slider name="slider-master"  low-value="0" high-value="1" class="setting-slider" />
                <ui:Label name="lbl-master"  text="100%" class="slider-value" />
            </ui:VisualElement>

            <ui:VisualElement class="slider-row">
                <ui:Label text="Music"   class="slider-label" />
                <ui:Slider name="slider-music"   low-value="0" high-value="1" class="setting-slider" />
                <ui:Label name="lbl-music"   text="80%"  class="slider-value" />
            </ui:VisualElement>

            <ui:VisualElement class="slider-row">
                <ui:Label text="SFX"     class="slider-label" />
                <ui:Slider name="slider-sfx"     low-value="0" high-value="1" class="setting-slider" />
                <ui:Label name="lbl-sfx"     text="100%" class="slider-value" />
            </ui:VisualElement>

            <!-- GRAPHICS -->
            <ui:Label text="GRAPHICS" class="section-label" />

            <ui:VisualElement class="toggle-row">
                <ui:Label text="Fullscreen" class="slider-label" />
                <ui:Toggle name="toggle-fullscreen" class="setting-toggle" />
            </ui:VisualElement>

            <ui:VisualElement class="toggle-row">
                <ui:Label text="Show FPS" class="slider-label" />
                <ui:Toggle name="toggle-fps" class="setting-toggle" />
            </ui:VisualElement>

            <!-- GAMEPLAY -->
            <ui:Label text="GAMEPLAY" class="section-label" />

            <ui:VisualElement class="toggle-row" tooltip="Display helpful on-screen tutorial tooltips once per match for equipment, controls, and house mechanics.">
                <ui:Label text="Tutorial Hints" class="slider-label toggle-label" tooltip="Display helpful on-screen tutorial tooltips once per match for equipment, controls, and house mechanics." />
                <ui:Toggle name="toggle-tutorial-hints" class="setting-toggle" tooltip="Display helpful on-screen tutorial tooltips once per match for equipment, controls, and house mechanics." />
            </ui:VisualElement>

            <ui:VisualElement class="toggle-row" tooltip="Show a subtle gray circle around your character indicating maximum interaction and placement reach.">
                <ui:Label text="Reach Circle" class="slider-label toggle-label" tooltip="Show a subtle gray circle around your character indicating maximum interaction and placement reach." />
                <ui:Toggle name="toggle-reach-indicator" class="setting-toggle" tooltip="Show a subtle gray circle around your character indicating maximum interaction and placement reach." />
            </ui:VisualElement>

            <ui:Button name="btn-settings-back" text="← Back" class="menu-button back-button" />
        </ui:VisualElement>

        <!-- ── PLAYERS PANEL ─────────────────────────────────────────── -->
        <ui:VisualElement name="panel-players" class="menu-container hidden">
            <ui:Label text="PLAYERS" class="title-label" />
            <ui:ScrollView name="player-list-scroll" class="player-scroll" />
            <ui:Button name="btn-players-back" text="← Back" class="menu-button back-button" />
        </ui:VisualElement>

        <!-- ── HELP & CONTROLS PANEL ─────────────────────────────────── -->
        <ui:VisualElement name="panel-controls" class="menu-container controls-container hidden">
            <ui:Label text="HELP &amp; CONTROLS" class="title-label" />

            <ui:ScrollView name="controls-scroll" class="controls-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                <ui:Label text="CONTROLS" class="section-label" />

                <ui:VisualElement class="control-row">
                    <ui:Label text="WASD" class="control-key" />
                    <ui:Label text="Move" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Mouse" class="control-key" />
                    <ui:Label text="Aim / Look" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Left Shift" class="control-key" />
                    <ui:Label text="Sprint" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="C" class="control-key" />
                    <ui:Label text="Crouch (Hide in Hide Spots)" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="L-Click" class="control-key" />
                    <ui:Label text="Use Held Item / Pick Up Equipment" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Hold L-Click" class="control-key" />
                    <ui:Label text="Drag Item" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="E" class="control-key" />
                    <ui:Label text="Interact (Doors, Switches, etc.)" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="F" class="control-key" />
                    <ui:Label text="Toggle Flashlight" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="R-Click" class="control-key" />
                    <ui:Label text="Place Equipment on Floor" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="1-3 / Scroll / Click" class="control-key" />
                    <ui:Label text="Select Hotbar Slot" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="G" class="control-key" />
                    <ui:Label text="Drop Held Item" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="J" class="control-key" />
                    <ui:Label text="Open / Close Journal" class="control-desc" />
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Esc" class="control-key" />
                    <ui:Label text="Pause / Back / Close UI" class="control-desc" />
                </ui:VisualElement>

                <ui:Label text="QUICK TIPS" class="section-label" />

                <ui:Label text="• Use equipment in the Ghost Room to gather 3 evidences and identify the entity in your Journal [J]." class="control-tip" />
                <ui:Label text="• Keep sanity up with lights and Sanity Pills; turn off handheld electronics and crouch [C] to hide during hunts." class="control-tip" />
                <ui:Label text="• Place Ritual Chalk [R-Click] in the Ghost Room to summon and exorcise the entity." class="control-tip" />
            </ui:ScrollView>

            <ui:Button name="btn-controls-back" text="← Back" class="menu-button back-button" />
        </ui:VisualElement>

    </ui:VisualElement>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--  HOST DISCONNECTED OVERLAY                                         -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <ui:VisualElement name="host-disconnect-overlay" class="overlay host-disconnect-overlay hidden">
        <ui:VisualElement name="panel-host-disconnect" class="menu-container host-disconnect-panel">
            <ui:Label text="CONNECTION LOST" class="host-disconnect-tag" />
            <ui:Label name="lbl-host-disconnect-title" text="HOST DISCONNECTED" class="title-label host-disconnect-title" />
            <ui:VisualElement class="host-disconnect-divider" />
            <ui:Label name="lbl-host-disconnect-msg" text="The lobby host has ended the session or lost connection. You can no longer continue in this lobby." class="host-disconnect-desc" />
            <ui:VisualElement class="button-container">
                <ui:Button name="btn-host-disconnect-menu" text="RETURN TO MAIN MENU" class="menu-button btn-danger host-disconnect-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
