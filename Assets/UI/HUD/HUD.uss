.hud-container {
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 20px;
}

.pause-container {
    align-self: flex-start;
}

.pause-button {
    width: 50px;
    height: 50px;
    font-size: 24px;
    background-color: rgba(10, 10, 10, 0.7);
    color: rgba(200, 200, 200, 0.8);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(100, 0, 0, 0.5);
    -unity-font-style: bold;
    transition-duration: 0.3s;
}

.pause-button:hover {
    background-color: rgba(30, 0, 0, 0.8);
    color: white;
    border-color: rgba(200, 0, 0, 0.8);
    scale: 1.05;
}

.inventory-container {
    flex-direction: row;
    align-self: center;
    justify-content: center;
    bottom: 20px;
    position: absolute;
    width: auto;
}

.inventory-slot {
    width: 80px;
    height: 80px;
    margin: 0 10px;
    background-color: rgba(10, 10, 10, 0.8);
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(50, 50, 50, 0.9);
    align-items: center;
    justify-content: center;
    transition-duration: 0.3s;
}

.inventory-slot-active {
    border-color: rgba(150, 0, 0, 1);
    background-color: rgba(30, 10, 10, 0.9);
    border-width: 2px;
    scale: 1.1;
}

.inventory-slot-text {
    color: rgba(180, 180, 180, 0.8);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.inventory-slot-active .inventory-slot-text {
    color: white;
}

.temperature-container {
    position: absolute;
    top: -35px;
    display: none;
    align-self: center;
}

.temperature-text {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}

.power-indicator {
    position: absolute;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: red;
    display: none;
    border-width: 1px;
    border-color: rgba(0,0,0,0.5);
}

.emf-container {
    position: absolute;
    top: 5px;
    flex-direction: row;
    display: none;
    align-self: center;
}

.emf-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 0 2px;
    background-color: gray;
    border-width: 1px;
    border-color: rgba(0,0,0,0.5);
}

/* ========================================================
   HANDHELD CAMERA NIGHT VISION VIEW FINDER GUI
   ======================================================== */
.nv-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 35px 45px;
}

.nv-overlay-hidden {
    display: none;
}

.nv-overlay-graphic {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/UI/HUD/night_vision_overlay.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.nv-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.nv-hud-text {
    color: rgb(235, 235, 235);
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.5);
}

.nv-hud-subtext {
    color: rgba(220, 220, 220, 0.85);
    font-size: 13px;
    -unity-font-style: normal;
}

.nv-rec-cluster {
    flex-direction: row;
    align-items: center;
}

.nv-rec-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(255, 30, 30);
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(150, 0, 0);
}

.nv-rec-dot-dim {
    opacity: 0.1;
}

.nv-rec-label {
    color: rgb(255, 50, 50);
    margin-right: 12px;
    text-shadow: 0 0 6px rgba(255, 0, 0, 0.7);
}

.nv-timer-label {
    color: rgb(235, 235, 235);
}

.nv-badge-cluster {
    background-color: rgba(20, 20, 20, 0.75);
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    padding: 3px 12px;
    border-radius: 3px;
}

.nv-nvg-badge {
    font-size: 14px;
}

.nv-battery-cluster {
    flex-direction: row;
    align-items: center;
}

.nv-battery-box {
    width: 28px;
    height: 14px;
    border-width: 2px;
    border-color: rgb(220, 220, 220);
    margin-left: 6px;
    margin-right: 6px;
    padding: 1px;
    border-radius: 2px;
}

.nv-battery-fill {
    width: 85%;
    height: 100%;
    background-color: rgb(220, 220, 220);
}

.nv-center-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.nv-bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
}

.nv-bottom-left {
    align-items: flex-start;
}

.nv-bottom-right {
    align-items: flex-end;
}

/* ─────────────────────────────────────────────────────────────
   Minecraft-Style Top-Right Tutorial Toast
   ───────────────────────────────────────────────────────────── */

.tutorial-toast-container {
    position: absolute;
    top: 20px;
    right: 20px;
    align-items: flex-end;
    justify-content: flex-start;
}

.tutorial-toast {
    width: 440px;
    background-color: rgba(18, 22, 28, 0.94);
    border-width: 1.5px;
    border-color: rgb(75, 88, 105);
    border-radius: 6px;
    padding: 12px 16px 14px 16px;
    opacity: 1;
    transition-duration: 0.3s;
}

.tutorial-toast-hidden {
    opacity: 0;
    display: none;
}

.toast-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.toast-key-badge {
    background-color: rgb(34, 43, 56);
    border-width: 1px;
    border-color: rgb(130, 150, 175);
    border-radius: 4px;
    padding: 2px 7px;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.toast-title {
    color: rgb(250, 192, 78);
    font-size: 13px;
    -unity-font-style: bold;
}

.toast-desc {
    color: rgb(220, 228, 236);
    font-size: 12.5px;
    white-space: normal;
    margin-bottom: 8px;
    -unity-text-align: middle-left;
}

.toast-progress-track {
    width: 100%;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 1.5px;
    overflow: hidden;
}

.toast-progress-bar {
    width: 100%;
    height: 100%;
    background-color: rgb(250, 192, 78);
}

/* ── Death / Game Over Screen ── */
.death-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 0, 0, 0.92);
    align-items: center;
    justify-content: center;
    transition-duration: 0.5s;
    opacity: 1;
}

.death-overlay-hidden {
    display: none;
    opacity: 0;
}

.death-panel {
    align-items: center;
    justify-content: center;
    padding: 45px 65px;
    background-color: rgba(16, 4, 4, 0.95);
    border-width: 2px;
    border-color: rgba(180, 20, 20, 0.85);
    border-radius: 4px;
}

.death-title {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255, 34, 34);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.death-subtitle {
    font-size: 18px;
    color: rgba(210, 210, 210, 0.85);
    margin-bottom: 35px;
    -unity-text-align: middle-center;
}

.death-button {
    width: 340px;
    height: 52px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(85, 12, 12, 0.9);
    border-width: 1px;
    border-color: rgba(220, 45, 45, 0.9);
    border-radius: 2px;
    transition-duration: 0.25s;
}

.death-button:hover {
    background-color: rgba(165, 25, 25, 0.95);
    border-color: rgb(255, 51, 51);
    color: rgb(255, 255, 255);
}

.death-button:active {
    background-color: rgba(100, 10, 10, 1);
}
