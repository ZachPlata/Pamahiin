@import url("project://database/Assets/Resources/UI/PamahiinTheme.uss");

/* ==========================================================================
   PLAYER HUD - 16-BIT PIXEL OVERLAY & TUTORIAL TOAST
   ========================================================================== */

.hud-container {
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 18px;
}

.pause-container {
    align-self: flex-start;
}

.pause-button {
    width: 48px;
    height: 48px;
    font-size: 14px;
    background-color: var(--pm-bg-deep);
    color: var(--pm-text-muted);
    border-radius: 0px;
    border-width: 2px;
    border-top-color: var(--pm-border-brass);
    border-left-color: var(--pm-border-brass);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    -unity-font-style: normal;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

.pause-button:hover {
    background-color: rgba(74, 18, 24, 0.94);
    color: var(--pm-text-primary);
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
}

.pause-button:active {
    translate: 0px 2px;
}

.inventory-container {
    flex-direction: row;
    align-self: center;
    justify-content: center;
    bottom: 18px;
    position: absolute;
    width: auto;
}

.inventory-slot {
    width: 98px;
    height: 84px;
    margin: 0 8px;
    padding: 4px;
    background-color: var(--pm-bg-deep);
    border-radius: 0px;
    border-width: 2px;
    border-top-color: var(--pm-border-dim);
    border-left-color: var(--pm-border-dim);
    border-right-color: rgba(12, 10, 14, 0.96);
    border-bottom-color: rgba(12, 10, 14, 0.96);
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.08s;
}

.inventory-slot-active {
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-crimson);
    border-bottom-color: var(--pm-border-crimson);
    background-color: rgba(44, 14, 18, 0.95);
    border-width: 3px;
}

.inventory-slot-text {
    color: var(--pm-text-muted);
    font-size: 8px;
    line-height: 12px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
}

.inventory-slot-active .inventory-slot-text {
    color: var(--pm-text-primary);
}

.temperature-container {
    position: absolute;
    top: -32px;
    align-self: center;
}

.temperature-text {
    font-size: 14px;
    color: var(--pm-text-primary);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.92);
}

.power-indicator {
    position: absolute;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 0px;
    background-color: red;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
}

.emf-container {
    position: absolute;
    top: 5px;
    flex-direction: row;
    align-self: center;
}

.emf-dot {
    width: 8px;
    height: 8px;
    border-radius: 0px;
    margin: 0 2px;
    background-color: gray;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
}

/* ========================================================= */
/* NIGHT VISION CAMERA OVERLAY HUD                           */
/* ========================================================= */

.nv-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 32px 42px;
}

.nv-overlay-hidden {
    display: none;
}

.nv-overlay-graphic {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/UI/HUD/night_vision_overlay.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.nv-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.nv-hud-text {
    color: rgb(235, 240, 235);
    font-size: 11px;
    -unity-font-style: normal;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.95);
}

.nv-hud-subtext {
    color: rgba(220, 226, 220, 0.88);
    font-size: 9px;
    -unity-font-style: normal;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.95);
}

.nv-rec-cluster {
    flex-direction: row;
    align-items: center;
}

.nv-rec-dot {
    width: 12px;
    height: 12px;
    border-radius: 0px;
    background-color: rgb(255, 34, 34);
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(110, 0, 0);
}

.nv-rec-dot-dim {
    opacity: 0.12;
}

.nv-rec-label {
    color: rgb(255, 62, 62);
    margin-right: 12px;
    text-shadow: 1px 1px 0px rgba(80, 0, 0, 0.95);
}

.nv-timer-label {
    color: rgb(235, 235, 235);
}

.nv-badge-cluster {
    background-color: rgba(12, 12, 16, 0.84);
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    padding: 4px 12px;
    border-radius: 0px;
}

.nv-nvg-badge {
    font-size: 9px;
}

.nv-battery-cluster {
    flex-direction: row;
    align-items: center;
}

.nv-battery-box {
    width: 28px;
    height: 14px;
    border-width: 2px;
    border-color: rgb(220, 220, 220);
    margin-left: 6px;
    margin-right: 6px;
    padding: 1px;
    border-radius: 0px;
}

.nv-battery-fill {
    width: 85%;
    height: 100%;
    background-color: rgb(220, 220, 220);
}

.nv-center-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.nv-bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
}

.nv-bottom-left {
    align-items: flex-start;
}

.nv-bottom-right {
    align-items: flex-end;
}

/* ========================================================= */
/* TUTORIAL TOOLTIP TOAST CARD (TOP RIGHT)                   */
/* ========================================================= */

.tutorial-toast-container {
    position: absolute;
    top: 18px;
    right: 18px;
    align-items: flex-end;
    justify-content: flex-start;
}

.tutorial-toast {
    width: 500px;
    max-width: 92%;
    background-color: var(--pm-bg-deep);
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    padding: 14px 18px;
    opacity: 1;
    transition-duration: 0.2s;
}

.tutorial-toast-hidden {
    opacity: 0;
    translate: 20px 0px;
}

.toast-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.toast-key-badge {
    background-color: rgb(32, 26, 22);
    border-width: 2px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    padding: 4px 8px;
    color: rgb(250, 212, 118);
    font-size: 9px;
    -unity-font-style: normal;
    margin-right: 10px;
}

.toast-title {
    color: var(--pm-accent-brass);
    font-size: 11px;
    -unity-font-style: normal;
    line-height: 16px;
    white-space: normal;
}

.toast-desc {
    color: var(--pm-text-primary);
    font-size: 9px;
    line-height: 15px;
    white-space: normal;
    margin-bottom: 10px;
    -unity-text-align: middle-left;
}

.toast-progress-track {
    width: 100%;
    height: 4px;
    background-color: var(--pm-bg-void);
    border-radius: 0px;
    overflow: hidden;
}

.toast-progress-bar {
    width: 100%;
    height: 100%;
    background-color: var(--pm-accent-brass);
}

/* ========================================================= */
/* DEATH OVERLAY ("YOU DIED")                                */
/* ========================================================= */

.death-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 2, 4, 0.94);
    align-items: center;
    justify-content: center;
    transition-duration: 0.4s;
    opacity: 1;
}

.death-overlay-hidden {
    display: none;
    opacity: 0;
}

.death-panel {
    align-items: center;
    justify-content: center;
    padding: 40px 56px;
    background-color: rgba(20, 6, 8, 0.96);
    border-width: 3px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
}

.death-title {
    font-size: 36px;
    -unity-font-style: normal;
    color: var(--pm-accent-crimson-hi);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.98);
}

.death-subtitle {
    font-size: 11px;
    color: var(--pm-text-muted);
    margin-bottom: 30px;
    -unity-text-align: middle-center;
    line-height: 18px;
    white-space: normal;
}

.death-button {
    width: 360px;
    height: 52px;
    font-size: 11px;
    -unity-font-style: normal;
    color: var(--pm-text-primary);
    background-color: rgba(98, 18, 24, 0.96);
    border-width: 3px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    transition-property: background-color, border-color;
    transition-duration: 0.08s;
}

.death-button:hover {
    background-color: rgba(154, 28, 36, 0.98);
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    color: rgb(255, 248, 224);
}

.death-button:active {
    background-color: rgba(84, 12, 16, 1);
    translate: 0px 2px;
}

/* ========================================================= */
/* SPECTATOR MODE BANNER                                     */
/* ========================================================= */

.spectator-banner {
    position: absolute;
    left: 0;
    top: 14px;
    right: 0;
    align-items: center;
    justify-content: flex-start;
}

.spectator-banner-hidden {
    display: none;
}

.spectator-pill {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px;
    background-color: rgba(12, 22, 34, 0.88);
    border-width: 2px;
    border-top-color: rgb(148, 202, 255);
    border-left-color: rgb(148, 202, 255);
    border-right-color: rgb(42, 74, 108);
    border-bottom-color: rgb(42, 74, 108);
    border-radius: 0px;
}

.spectator-pill-label {
    font-size: 9px;
    -unity-font-style: normal;
    letter-spacing: 1px;
    color: rgb(148, 202, 255);
}

.spectator-grace-label {
    font-size: 9px;
    color: rgba(212, 232, 252, 0.94);
    margin-left: 10px;
}

.spectator-end-btn {
    margin-left: 10px;
    height: 26px;
    padding: 0 10px;
    font-size: 9px;
    -unity-font-style: normal;
    color: rgb(232, 246, 255);
    background-color: rgba(34, 72, 108, 0.92);
    border-width: 2px;
    border-top-color: rgb(154, 208, 255);
    border-left-color: rgb(154, 208, 255);
    border-right-color: rgb(24, 48, 74);
    border-bottom-color: rgb(24, 48, 74);
    border-radius: 0px;
    transition-duration: 0.08s;
}

.spectator-end-btn:hover {
    background-color: rgba(54, 108, 158, 0.98);
    color: rgb(255, 255, 255);
}

.spectator-grace-hidden {
    display: none;
}
