.dev-console-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.82);
    align-items: center;
    justify-content: center;
    display: none;
}

.dev-console-panel {
    width: 92%;
    max-width: 1200px;
    height: 85%;
    max-height: 750px;
    background-color: rgba(18, 22, 26, 0.96);
    border-width: 2px;
    border-color: rgba(60, 140, 100, 0.7);
    border-radius: 10px;
    flex-direction: column;
    padding: 16px 20px;
}

.dev-console-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-bottom: 10px;
    margin-bottom: 12px;
}

.dev-console-title {
    color: rgb(0, 255, 136);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.dev-console-subtitle {
    color: rgb(160, 180, 170);
    font-size: 13px;
}

.dev-console-scroll {
    flex-grow: 1;
}

.columns-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    width: 100%;
}

.column {
    flex-direction: column;
    align-items: stretch;
    width: 23%;
    min-width: 220px;
    margin-bottom: 15px;
}

.column-header {
    color: rgb(220, 235, 225);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    -unity-text-align: middle-center;
}

.dev-console-button {
    height: 42px;
    margin-top: 5px;
    margin-bottom: 5px;
    font-size: 14px;
    background-color: rgba(35, 42, 50, 0.95);
    color: rgb(240, 245, 240);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 100, 110, 0.8);
    -unity-font-style: bold;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, scale;
}

.dev-console-button:hover {
    background-color: rgba(55, 70, 85, 1);
    border-color: rgb(0, 255, 136);
    scale: 1.02;
}

.dev-console-button:active {
    background-color: rgba(25, 30, 38, 1);
    scale: 0.98;
}

.btn-danger {
    border-color: rgba(220, 60, 60, 0.8);
}

.btn-danger:hover {
    background-color: rgba(140, 30, 30, 0.9);
    border-color: rgb(255, 80, 80);
}

.btn-warning {
    border-color: rgba(220, 160, 40, 0.8);
}

.btn-warning:hover {
    background-color: rgba(130, 95, 20, 0.9);
    border-color: rgb(255, 190, 60);
}

.btn-primary {
    border-color: rgba(60, 130, 220, 0.8);
}

.btn-primary:hover {
    background-color: rgba(30, 80, 150, 0.9);
    border-color: rgb(80, 170, 255);
}

.dev-console-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    padding-top: 10px;
    margin-top: 8px;
}

.dev-console-status {
    color: rgb(130, 230, 170);
    font-size: 13px;
    -unity-font-style: italic;
}

.dev-console-close-button {
    width: 140px;
    height: 36px;
    font-size: 13px;
    background-color: rgba(60, 30, 35, 0.9);
    color: rgb(255, 200, 200);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(180, 60, 60, 0.6);
}

.dev-console-close-button:hover {
    background-color: rgba(120, 40, 45, 1);
    border-color: rgb(255, 80, 80);
}
