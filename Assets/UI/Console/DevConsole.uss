@import url("project://database/Assets/Resources/UI/PamahiinTheme.uss");

/* ==========================================================================
   DEVELOPER CONSOLE - 16-BIT TERMINAL OVERLAY
   ========================================================================== */

.dev-console-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 6, 8, 0.86);
    align-items: center;
    justify-content: center;
}

.dev-console-panel {
    width: 94%;
    max-width: 1180px;
    height: 86%;
    max-height: 750px;
    background-color: var(--pm-crt-bg);
    border-width: 3px;
    border-top-color: var(--pm-crt-border);
    border-left-color: var(--pm-crt-border);
    border-right-color: var(--pm-crt-border-lo);
    border-bottom-color: var(--pm-crt-border-lo);
    border-radius: 0px;
    flex-direction: column;
    padding: 16px 20px;
}

.dev-console-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: var(--pm-crt-border-lo);
    padding-bottom: 10px;
    margin-bottom: 12px;
}

.dev-console-title {
    color: var(--pm-accent-phosphor);
    font-size: 16px;
    -unity-font-style: normal;
    letter-spacing: 2px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

.dev-console-subtitle {
    color: rgb(164, 192, 174);
    font-size: 9px;
}

.dev-console-scroll {
    flex-grow: 1;
}

.columns-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    width: 100%;
}

.column {
    flex-direction: column;
    align-items: stretch;
    width: 24%;
    min-width: 250px;
    margin-bottom: 15px;
}

.column-header {
    color: var(--pm-accent-brass);
    font-size: 10px;
    -unity-font-style: normal;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 2px;
    border-bottom-color: var(--pm-crt-border-lo);
    -unity-text-align: middle-center;
}

.dev-console-button {
    min-height: 38px;
    height: auto;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 7px 10px;
    font-size: 9px;
    white-space: normal;
    background-color: rgba(20, 32, 26, 0.96);
    color: var(--pm-text-primary);
    border-radius: 0px;
    border-width: 2px;
    border-top-color: rgb(62, 124, 86);
    border-left-color: rgb(62, 124, 86);
    border-right-color: rgb(18, 40, 28);
    border-bottom-color: rgb(18, 40, 28);
    -unity-font-style: normal;
    transition-duration: 0.08s;
    transition-property: background-color, border-color, color;
}

.dev-console-button:hover {
    background-color: rgba(32, 58, 44, 0.98);
    border-top-color: var(--pm-accent-phosphor);
    border-left-color: var(--pm-accent-phosphor);
    color: rgb(255, 255, 255);
}

.dev-console-button:active {
    background-color: rgba(14, 24, 18, 1);
    translate: 0px 2px;
}

.btn-danger {
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    background-color: rgba(62, 18, 22, 0.95);
}

.btn-danger:hover {
    background-color: rgba(128, 28, 34, 0.98);
    border-color: var(--pm-accent-crimson-hi);
}

.btn-warning {
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    background-color: rgba(62, 46, 18, 0.95);
}

.btn-warning:hover {
    background-color: rgba(118, 84, 24, 0.98);
    border-color: var(--pm-crt-amber);
}

.btn-primary {
    border-top-color: var(--pm-accent-teal);
    border-left-color: var(--pm-accent-teal);
    border-right-color: rgba(24, 62, 68, 0.95);
    border-bottom-color: rgba(24, 62, 68, 0.95);
    background-color: rgba(18, 44, 58, 0.95);
}

.btn-primary:hover {
    background-color: rgba(32, 78, 102, 0.98);
    border-color: rgb(118, 212, 228);
}

.dev-console-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-top-width: 2px;
    border-top-color: var(--pm-crt-border-lo);
    padding-top: 10px;
    margin-top: 8px;
}

.dev-console-status {
    color: var(--pm-accent-phosphor);
    font-size: 9px;
    -unity-font-style: normal;
}

.dev-console-close-button {
    width: 140px;
    height: 36px;
    font-size: 9px;
    background-color: rgba(78, 22, 26, 0.95);
    color: rgb(255, 220, 220);
    border-radius: 0px;
    border-width: 2px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
}

.dev-console-close-button:hover {
    background-color: rgba(132, 34, 40, 1);
    border-color: var(--pm-accent-crimson-hi);
}

.dev-console-close-button:active {
    translate: 0px 2px;
}

.dev-balance-label {
    color: var(--pm-accent-phosphor);
    font-size: 9px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.dev-currency-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 3px;
    margin-bottom: 3px;
}

.dev-currency-btn {
    flex-grow: 1;
    min-height: 32px;
    height: 32px;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 2px;
    margin-right: 2px;
    font-size: 9px;
    padding-left: 4px;
    padding-right: 4px;
}

.dev-currency-input {
    width: 82px;
    height: 32px;
    margin-right: 4px;
    font-size: 10px;
}

.dev-currency-input > .unity-text-field__input {
    background-color: var(--pm-bg-void);
    color: var(--pm-text-primary);
    border-color: var(--pm-crt-border);
    border-width: 2px;
    border-radius: 0px;
    -unity-text-align: middle-center;
    font-size: 10px;
}
