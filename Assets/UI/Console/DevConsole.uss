.dev-console-container {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.dev-console-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.dev-console-button {
    width: 250px;
    height: 50px;
    margin: 10px;
    font-size: 18px;
    background-color: rgb(40, 40, 40);
    color: white;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    -unity-font-style: bold;
    cursor: link;
    transition-duration: 0.15s;
}

.dev-console-button:hover {
    background-color: rgb(80, 80, 80);
    scale: 1.05;
}

.columns-container {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
}

.column {
    flex-direction: column;
    align-items: center;
    margin-left: 20px;
    margin-right: 20px;
}
