@import url("project://database/Assets/Resources/UI/PamahiinTheme.uss");

/* ==========================================================================
   MAIN MENU STYLESHEET - 16-BIT PIXEL ART THEME
   ========================================================================== */

.main-container {
    flex-grow: 1;
    background-image: url('project://database/Assets/UI/MainMenu/MainMenuBackground.png');
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.view {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 0;
    top: 0;
}

.active-view {
    display: flex;
}

.hidden-view {
    display: none;
}

.title-label {
    font-size: 56px;
    color: var(--pm-accent-crimson-hi);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    letter-spacing: 6px;
    margin-bottom: 14px;
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.96);
}

.subtitle-label {
    font-size: 12px;
    color: var(--pm-accent-brass);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    letter-spacing: 2px;
    margin-bottom: 42px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.92);
}

.button-container {
    width: 360px;
    max-width: 90%;
    align-items: stretch;
}

.menu-button {
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 14px 18px;
    font-size: 13px;
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    background-color: var(--pm-bg-elevated);
    color: var(--pm-text-primary);
    border-width: 3px;
    border-top-color: var(--pm-border-brass);
    border-left-color: var(--pm-border-brass);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

.menu-button:hover {
    background-color: rgb(62, 34, 42);
    color: var(--pm-border-brass-hi);
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
}

.menu-button:active {
    background-color: var(--pm-accent-crimson);
    color: rgb(255, 250, 240);
    translate: 0px 2px;
}

.back-button {
    margin-top: 22px;
    background-color: var(--pm-bg-deep);
    color: var(--pm-text-muted);
    font-size: 11px;
}

.start-button {
    background-color: rgba(112, 22, 32, 0.96);
    color: rgb(255, 244, 228);
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
}

.start-button:hover {
    background-color: rgba(162, 34, 48, 0.98);
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
}

.join-container {
    margin-top: 16px;
    margin-bottom: 16px;
    background-color: var(--pm-bg-panel);
    border-width: 2px;
    border-top-color: var(--pm-border-brass);
    border-left-color: var(--pm-border-brass);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    padding: 14px;
    border-radius: 0px;
}

.menu-input {
    margin-bottom: 10px;
}

.menu-input > .unity-text-field__label {
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    color: var(--pm-text-muted);
    font-size: 10px;
    min-width: 110px;
}

.menu-input > .unity-base-text-field__input {
    background-color: var(--pm-bg-void);
    color: var(--pm-text-primary);
    border-width: 2px;
    border-color: var(--pm-border-brass-lo);
    border-radius: 0px;
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 11px;
    padding: 6px 8px;
}

.bg-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-width: 20px;
    border-color: rgba(4, 3, 6, 0.72);
}

.bg-mist {
    background-color: rgba(16, 8, 12, 0.36);
}

.player-list-container {
    width: 480px;
    max-width: 92%;
    height: 250px;
    background-color: var(--pm-bg-panel);
    border-color: var(--pm-border-crimson);
    border-width: 3px;
    border-radius: 0px;
    margin-bottom: 18px;
    padding: 12px;
}

.player-slot {
    font-size: 11px;
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    color: var(--pm-text-primary);
    padding: 10px 12px;
    background-color: var(--pm-bg-deep);
    border-width: 2px;
    border-color: var(--pm-border-dim);
    margin-bottom: 6px;
    border-radius: 0px;
}

.controls-list {
    width: 620px;
    max-width: 92%;
    background-color: var(--pm-bg-panel);
    padding: 26px 32px;
    border-radius: 0px;
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    align-items: stretch;
}

.controls-scroll {
    max-height: 400px;
    margin-bottom: 6px;
    padding-right: 4px;
}

.control-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 6px;
    border-bottom-width: 1px;
    border-color: var(--pm-border-dim);
}

.control-key {
    width: 215px;
    flex-shrink: 0;
    font-size: 9px;
    color: var(--pm-accent-brass);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    padding-right: 10px;
    white-space: normal;
}

.control-desc {
    flex-grow: 1;
    font-size: 9px;
    color: var(--pm-text-primary);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    white-space: normal;
}

.control-tip {
    font-size: 8px;
    color: var(--pm-text-muted);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    margin-top: 6px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.settings-container {
    background-color: var(--pm-bg-panel);
    padding: 26px 32px;
    border-radius: 0px;
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    width: 520px;
    max-width: 92%;
    align-items: stretch;
}

.settings-title {
    font-size: 22px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.section-label {
    font-size: 10px;
    color: var(--pm-accent-brass);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    margin-top: 12px;
    margin-bottom: 6px;
    border-bottom-width: 2px;
    border-color: var(--pm-border-brass-lo);
    padding-bottom: 4px;
    letter-spacing: 2px;
}

.slider-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.slider-label {
    width: 110px;
    font-size: 10px;
    color: var(--pm-text-primary);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

.setting-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

.slider-value {
    width: 56px;
    font-size: 10px;
    color: var(--pm-accent-brass);
    -unity-font: url('project://database/Assets/Fonts/PressStart2P-Regular.ttf');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

.toggle-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.setting-toggle {
    margin-left: auto;
}

.toggle-label {
    width: 260px;
    font-size: 10px;
}
