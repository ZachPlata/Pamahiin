@import url("project://database/Assets/Resources/UI/PamahiinTheme.uss");

/* ==========================================================================
   EXORCISM RITUAL UI - 16-BIT PIXEL DIAL & POPUP
   ========================================================================== */

.hidden {
    display: none;
}

/* Ghost Guessing Modal Overlay */
.modal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 3, 6, 0.84);
    justify-content: center;
    align-items: center;
}

.popup-panel {
    background-color: var(--pm-bg-panel);
    border-width: 3px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    padding: 22px 26px;
    width: 820px;
    max-width: 92%;
    align-items: center;
}

.popup-title {
    font-size: 15px;
    color: var(--pm-accent-crimson-hi);
    -unity-font-style: normal;
    letter-spacing: 2px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

.popup-subtitle {
    font-size: 10px;
    color: var(--pm-text-muted);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 15px;
}

.ghost-buttons-scroll {
    width: 100%;
    max-height: 360px;
    margin-bottom: 14px;
}

.ghost-buttons-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.ghost-btn {
    width: 178px;
    min-height: 44px;
    background-color: rgba(48, 14, 18, 0.94);
    border-width: 2px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    padding: 8px 10px;
    margin: 4px;
    font-size: 9px;
    color: var(--pm-text-primary);
    -unity-font-style: normal;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

.ghost-btn-guessed {
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-brass-lo);
    border-bottom-color: var(--pm-border-brass-lo);
    background-color: rgba(88, 42, 16, 0.96);
    color: rgb(255, 240, 185);
}

.ghost-btn:hover {
    background-color: rgba(146, 26, 36, 0.98);
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    color: rgb(255, 248, 224);
}

.ghost-btn:active {
    background-color: rgba(96, 14, 20, 1);
    translate: 0px 2px;
}

.popup-warning {
    font-size: 9px;
    color: rgba(255, 118, 118, 0.92);
    -unity-font-style: normal;
    margin-top: 6px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Active Exorcism QTE Overlay */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 28px;
}

.circular-minigame-container {
    background-color: rgba(14, 6, 10, 0.96);
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    padding: 18px 28px 20px 28px;
    align-items: center;
}

.title-label {
    font-size: 13px;
    color: var(--pm-accent-crimson-hi);
    -unity-font-style: normal;
    letter-spacing: 2px;
    margin-bottom: 12px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

/* 192x192 (2x integer scale of 96x96 FilterMode.Point ExorcismDial.png) */
.circle-dial {
    width: 192px;
    height: 192px;
    border-radius: 0px;
    border-width: 0px;
    background-color: transparent;
    background-image: url("project://database/Assets/Resources/UI/Sprites/ExorcismDial.png");
    -unity-background-scale-mode: stretch-to-fill;
    justify-content: center;
    align-items: center;
    position: relative;
    margin-bottom: 12px;
}

.target-bar-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
}

.target-hit-line {
    width: 28px;
    height: 16px;
    border-radius: 0px;
    background-color: rgb(250, 212, 68);
    border-width: 2px;
    border-top-color: rgb(255, 250, 210);
    border-left-color: rgb(255, 250, 210);
    border-right-color: rgb(146, 98, 22);
    border-bottom-color: rgb(146, 98, 22);
    margin-top: -4px;
}

.needle-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
}

.needle-pointer {
    width: 10px;
    height: 24px;
    border-radius: 0px;
    background-color: rgb(238, 46, 54);
    border-width: 2px;
    border-top-color: rgb(255, 224, 224);
    border-left-color: rgb(255, 224, 224);
    border-right-color: rgb(118, 14, 20);
    border-bottom-color: rgb(118, 14, 20);
    margin-top: -6px;
}

.center-rune {
    width: 84px;
    height: 84px;
    border-radius: 0px;
    background-color: transparent;
    border-width: 0px;
    justify-content: center;
    align-items: center;
}

.prompt-key-label {
    font-size: 28px;
    color: rgb(255, 225, 84);
    -unity-font-style: normal;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.98);
    margin: 0;
    padding: 0;
}

.prompt-subtext {
    font-size: 8px;
    color: var(--pm-text-muted);
    letter-spacing: 1px;
    margin-top: 4px;
}

.stats-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.stat-badge {
    padding: 5px 10px;
    border-radius: 0px;
    font-size: 9px;
    -unity-font-style: normal;
    border-width: 2px;
    margin-left: 4px;
    margin-right: 4px;
}

.chants-badge {
    background-color: rgba(20, 74, 38, 0.72);
    color: rgb(138, 255, 168);
    border-color: rgb(60, 180, 96);
}

.loop-badge {
    background-color: rgba(94, 68, 18, 0.72);
    color: rgb(255, 222, 118);
    border-color: var(--pm-border-brass);
}

.mistakes-badge {
    background-color: rgba(96, 18, 22, 0.72);
    color: rgb(255, 128, 128);
    border-color: var(--pm-border-crimson-hi);
}

.instruction-label {
    font-size: 9px;
    color: var(--pm-text-muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Banner */
.banner-overlay {
    position: absolute;
    width: 100%;
    top: 46px;
    align-items: center;
}

.banner-box {
    background-color: rgba(14, 6, 8, 0.96);
    border-width: 3px;
    border-top-color: var(--pm-border-brass-hi);
    border-left-color: var(--pm-border-brass-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    padding: 16px 32px;
    align-items: center;
}

.banner-title-text {
    font-size: 14px;
    color: rgb(255, 214, 72);
    -unity-font-style: normal;
    letter-spacing: 2px;
    margin-bottom: 8px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

.banner-body-text {
    font-size: 11px;
    color: var(--pm-text-primary);
    -unity-font-style: normal;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.banner-hint-text {
    font-size: 9px;
    color: var(--pm-text-muted);
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Crucifix Repel Banner */
.repel-overlay {
    position: absolute;
    width: 100%;
    top: 40px;
    align-items: center;
}

.repel-box {
    background-color: rgba(34, 6, 8, 0.96);
    border-width: 3px;
    border-top-color: var(--pm-border-crimson-hi);
    border-left-color: var(--pm-border-crimson-hi);
    border-right-color: var(--pm-border-crimson-lo);
    border-bottom-color: var(--pm-border-crimson-lo);
    border-radius: 0px;
    padding: 14px 26px;
    align-items: center;
}

.repel-title {
    font-size: 12px;
    color: rgb(255, 86, 86);
    -unity-font-style: normal;
    letter-spacing: 1px;
    margin-bottom: 6px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

.repel-countdown {
    font-size: 20px;
    color: rgb(255, 230, 88);
    -unity-font-style: normal;
    margin-bottom: 6px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.95);
}

.repel-instruction {
    font-size: 10px;
    color: rgb(244, 214, 214);
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: middle-center;
}
