.overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 50px;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.hidden {
    display: none;
}

.minigame-container {
    background-color: rgba(20, 0, 0, 0.85);
    border-width: 2px;
    border-color: rgb(200, 50, 50);
    padding: 20px;
    width: 600px;
    align-items: center;
    border-radius: 10px;
}

.title-label {
    font-size: 28px;
    color: rgb(255, 50, 50);
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.progress-bar-bg {
    width: 500px;
    height: 40px;
    background-color: rgb(50, 50, 50);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    position: relative;
    margin-bottom: 20px;
}

.sweet-spot {
    position: absolute;
    height: 100%;
    width: 80px;
    background-color: rgba(255, 50, 50, 0.7);
    left: 200px; /* This will be set dynamically via script */
}

.cursor {
    position: absolute;
    width: 10px;
    height: 120%;
    top: -10%;
    background-color: white;
    left: 0px; /* Moved via script */
}

.instruction-label {
    font-size: 16px;
    color: rgb(200, 200, 200);
    margin-bottom: 10px;
}

.score-label {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
}
