/* Exorcism UI Theme */

.hidden {
    display: none;
}

/* 1. Modal Overlay for Ghost Selection */
.modal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
}

.popup-panel {
    background-color: rgba(16, 4, 4, 0.95);
    border-width: 2px;
    border-color: rgb(220, 50, 50);
    border-radius: 12px;
    padding: 26px 36px;
    min-width: 580px;
    align-items: center;
}

.popup-title {
    font-size: 26px;
    color: rgb(255, 60, 60);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.popup-subtitle {
    font-size: 15px;
    color: rgb(210, 190, 190);
    margin-bottom: 22px;
}

.ghost-buttons-row {
    flex-direction: row;
    gap: 16px;
    margin-bottom: 18px;
}

.ghost-btn {
    background-color: rgba(50, 10, 10, 0.9);
    border-width: 2px;
    border-color: rgb(200, 50, 50);
    border-radius: 8px;
    padding: 12px 22px;
    font-size: 16px;
    color: rgb(255, 230, 230);
    -unity-font-style: bold;
    letter-spacing: 1px;
    cursor: link;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.ghost-btn:hover {
    background-color: rgb(180, 25, 25);
    border-color: rgb(255, 120, 120);
    scale: 1.05 1.05;
}

.ghost-btn:active {
    background-color: rgb(120, 15, 15);
    scale: 0.98 0.98;
}

.popup-warning {
    font-size: 12px;
    color: rgba(255, 100, 100, 0.85);
    -unity-font-style: italic;
    margin-top: 4px;
}

/* 2. Circular Skill Check Overlay */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 30px;
}

.circular-minigame-container {
    background-color: rgba(14, 3, 3, 0.94);
    border-width: 2px;
    border-color: rgb(220, 45, 45);
    border-radius: 16px;
    padding: 16px 30px 20px 30px;
    align-items: center;
}

.title-label {
    font-size: 20px;
    color: rgb(255, 60, 60);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

/* Circle Dial (Outer Wheel) */
.circle-dial {
    width: 190px;
    height: 190px;
    border-radius: 95px;
    border-width: 6px;
    border-color: rgba(220, 50, 50, 0.75);
    background-color: rgba(28, 6, 6, 0.85);
    justify-content: center;
    align-items: center;
    position: relative;
    margin-bottom: 12px;
}

/* Target Hit Bar / Line */
.target-bar-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
}

.target-hit-line {
    width: 32px;
    height: 18px;
    border-radius: 4px;
    background-color: rgb(255, 220, 50);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    margin-top: -9px;
}

/* Needle Rotator */
.needle-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
    /* Rotation applied dynamically in C# via needleContainer.style.rotate */
}

.needle-pointer {
    width: 10px;
    height: 26px;
    border-radius: 3px;
    background-color: rgb(255, 40, 40);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    margin-top: -13px;
}

/* Center Rune Core */
.center-rune {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(10, 2, 2, 0.95);
    border-width: 3px;
    border-color: rgb(230, 60, 60);
    justify-content: center;
    align-items: center;
}

.prompt-key-label {
    font-size: 48px;
    color: rgb(255, 225, 75);
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 200, 50, 0.8);
    margin: 0;
    padding: 0;
}

.prompt-subtext {
    font-size: 10px;
    color: rgb(180, 160, 160);
    letter-spacing: 1px;
    margin-top: -4px;
}

/* Stats Row */
.stats-row {
    flex-direction: row;
    gap: 12px;
    margin-bottom: 8px;
}

.stat-badge {
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.chants-badge {
    background-color: rgba(25, 90, 45, 0.45);
    color: rgb(130, 255, 160);
    border-width: 1px;
    border-color: rgb(60, 180, 90);
}

.loop-badge {
    background-color: rgba(110, 80, 20, 0.45);
    color: rgb(255, 220, 110);
    border-width: 1px;
    border-color: rgb(210, 160, 40);
}

.mistakes-badge {
    background-color: rgba(110, 20, 20, 0.45);
    color: rgb(255, 110, 110);
    border-width: 1px;
    border-color: rgb(220, 50, 50);
}

.instruction-label {
    font-size: 13px;
    color: rgb(200, 180, 180);
}

/* 3. Dialogue / Banner Overlay */
.banner-overlay {
    position: absolute;
    width: 100%;
    top: 50px;
    align-items: center;
}

.banner-box {
    background-color: rgba(12, 4, 4, 0.96);
    border-width: 2px;
    border-color: rgb(255, 200, 60);
    border-radius: 10px;
    padding: 16px 36px;
    align-items: center;
}

.banner-title-text {
    font-size: 20px;
    color: rgb(255, 210, 60);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.banner-body-text {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.banner-hint-text {
    font-size: 14px;
    color: rgb(180, 180, 180);
    -unity-font-style: italic;
}

/* 4. Crucifix Repel Countdown Overlay */
.repel-overlay {
    position: absolute;
    width: 100%;
    top: 40px;
    align-items: center;
}

.repel-box {
    background-color: rgba(30, 5, 5, 0.95);
    border-width: 3px;
    border-color: rgb(255, 40, 40);
    border-radius: 10px;
    padding: 14px 28px;
    align-items: center;
}

.repel-title {
    font-size: 18px;
    color: rgb(255, 70, 70);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.repel-countdown {
    font-size: 30px;
    color: rgb(255, 230, 80);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.repel-instruction {
    font-size: 14px;
    color: rgb(240, 210, 210);
    -unity-font-style: bold;
}
