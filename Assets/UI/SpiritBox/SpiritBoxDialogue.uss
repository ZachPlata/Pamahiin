.sb-overlay {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 120px;
    picking-mode: ignore;
}

.sb-panel {
    width: 580px;
    background-color: rgba(12, 16, 16, 0.94);
    border-width: 1px;
    border-color: rgba(60, 200, 140, 0.4);
    border-radius: 6px;
    padding: 14px 18px 12px 18px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.85);
}

.sb-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 200, 140, 0.25);
    margin-bottom: 10px;
}

.sb-header-left {
    flex-direction: row;
    align-items: center;
}

.sb-led-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #3bf08b;
    margin-right: 8px;
    box-shadow: 0 0 8px #3bf08b;
}

.sb-title {
    color: #a4ebd0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.sb-frequency {
    color: #4ef0a0;
    font-size: 12px;
    -unity-font-style: bold;
}

.sb-screen {
    background-color: rgba(6, 14, 11, 0.96);
    border-width: 1px;
    border-color: rgba(45, 140, 95, 0.5);
    border-radius: 4px;
    padding: 10px 12px;
    margin-bottom: 12px;
}

.sb-screen-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.sb-screen-status {
    color: #55c48b;
    font-size: 11px;
    -unity-font-style: bold;
}

.sb-signal-meter {
    color: #4ef0a0;
    font-size: 10px;
    -unity-font-style: bold;
}

.sb-screen-transcript {
    color: #e2fbf0;
    font-size: 14px;
    -unity-font-style: bold;
    min-height: 24px;
    white-space: normal;
    text-shadow: 0 0 4px rgba(60, 240, 150, 0.4);
}

.sb-options-container {
    flex-direction: column;
    margin-bottom: 10px;
}

.sb-option-btn {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 34px;
    margin-bottom: 4px;
    padding: 0 10px;
    background-color: rgba(20, 26, 24, 0.75);
    border-width: 1px;
    border-color: rgba(60, 120, 90, 0.4);
    border-radius: 4px;
    transition-duration: 0.15s;
}

.sb-option-btn:hover {
    background-color: rgba(30, 48, 40, 0.9);
    border-color: rgba(80, 220, 150, 0.8);
}

.sb-option-selected {
    background-color: rgba(25, 60, 45, 0.95);
    border-color: #3bf08b;
    border-width: 1px;
    box-shadow: 0 0 10px rgba(59, 240, 139, 0.35);
}

.sb-option-badge {
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background-color: rgba(35, 75, 55, 0.9);
    color: #4ef0a0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 12px;
}

.sb-option-selected .sb-option-badge {
    background-color: #3bf08b;
    color: #0c1a13;
}

.sb-option-text {
    flex-grow: 1;
    color: #cce9db;
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.sb-option-selected .sb-option-text {
    color: #ffffff;
    -unity-font-style: bold;
}

.sb-option-arrow {
    color: transparent;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.sb-option-selected .sb-option-arrow {
    color: #3bf08b;
}

.sb-footer {
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(60, 200, 140, 0.2);
    align-items: center;
}

.sb-footer-text {
    color: rgba(160, 210, 190, 0.8);
    font-size: 11px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}
