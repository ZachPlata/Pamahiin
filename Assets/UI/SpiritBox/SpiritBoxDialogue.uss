@import url("project://database/Assets/Resources/UI/PamahiinTheme.uss");

/* ==========================================================================
   SPIRIT BOX DIALOGUE - 16-BIT CRT PHOSPHOR RADIO TERMINAL
   ========================================================================== */

.sb-overlay {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 100px;
}

.sb-panel {
    width: 640px;
    max-width: 92%;
    background-color: var(--pm-crt-bg);
    border-width: 3px;
    border-top-color: var(--pm-crt-border);
    border-left-color: var(--pm-crt-border);
    border-right-color: var(--pm-crt-border-lo);
    border-bottom-color: var(--pm-crt-border-lo);
    border-radius: 0px;
    padding: 14px 18px 12px 18px;
}

.sb-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: var(--pm-crt-border-lo);
    margin-bottom: 10px;
}

.sb-header-left {
    flex-direction: row;
    align-items: center;
}

.sb-led-dot {
    width: 10px;
    height: 10px;
    border-radius: 0px;
    background-color: rgb(74, 222, 128);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
    margin-right: 8px;
}

.sb-title {
    color: rgb(180, 245, 205);
    font-size: 10px;
    -unity-font-style: normal;
    letter-spacing: 1px;
}

.sb-frequency {
    color: var(--pm-accent-phosphor);
    font-size: 10px;
    -unity-font-style: normal;
}

.sb-screen {
    background-color: rgba(5, 11, 8, 0.98);
    border-width: 2px;
    border-top-color: var(--pm-crt-border-lo);
    border-left-color: var(--pm-crt-border-lo);
    border-right-color: var(--pm-crt-border);
    border-bottom-color: var(--pm-crt-border);
    border-radius: 0px;
    padding: 10px 12px;
    margin-bottom: 10px;
}

.sb-screen-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.sb-screen-status {
    color: rgb(96, 206, 142);
    font-size: 9px;
    -unity-font-style: normal;
}

.sb-signal-meter {
    color: var(--pm-accent-phosphor);
    font-size: 9px;
    -unity-font-style: normal;
}

.sb-screen-transcript {
    color: rgb(224, 250, 234);
    font-size: 11px;
    -unity-font-style: normal;
    min-height: 28px;
    line-height: 17px;
    white-space: normal;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.95);
}

.sb-options-container {
    flex-direction: column;
    margin-bottom: 10px;
}

.sb-option-btn {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 36px;
    margin-bottom: 4px;
    padding: 4px 10px;
    background-color: rgba(14, 24, 19, 0.92);
    border-width: 2px;
    border-top-color: rgba(54, 128, 86, 0.75);
    border-left-color: rgba(54, 128, 86, 0.75);
    border-right-color: rgba(16, 44, 28, 0.9);
    border-bottom-color: rgba(16, 44, 28, 0.9);
    border-radius: 0px;
    transition-property: background-color, border-color;
    transition-duration: 0.08s;
}

.sb-option-btn:hover {
    background-color: rgba(24, 48, 36, 0.96);
    border-top-color: rgb(96, 224, 148);
    border-left-color: rgb(96, 224, 148);
}

.sb-option-selected {
    background-color: rgba(22, 62, 42, 0.98);
    border-width: 2px;
    border-top-color: rgb(96, 240, 152);
    border-left-color: rgb(96, 240, 152);
    border-right-color: rgb(32, 112, 68);
    border-bottom-color: rgb(32, 112, 68);
}

.sb-option-badge {
    width: 22px;
    height: 22px;
    border-radius: 0px;
    background-color: rgba(24, 62, 42, 0.95);
    border-width: 1px;
    border-color: var(--pm-crt-border);
    color: var(--pm-accent-phosphor);
    font-size: 9px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    margin-right: 12px;
}

.sb-option-selected .sb-option-badge {
    background-color: rgb(74, 222, 128);
    color: rgb(8, 22, 14);
    border-color: rgb(12, 32, 20);
}

.sb-option-text {
    flex-grow: 1;
    color: rgb(206, 236, 218);
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    white-space: normal;
}

.sb-option-selected .sb-option-text {
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
}

.sb-option-arrow {
    color: transparent;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.sb-option-selected .sb-option-arrow {
    color: rgb(74, 222, 128);
}

.sb-footer {
    padding-top: 8px;
    border-top-width: 2px;
    border-top-color: var(--pm-crt-border-lo);
    align-items: center;
}

.sb-footer-text {
    color: rgba(168, 220, 188, 0.88);
    font-size: 8px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 14px;
}
