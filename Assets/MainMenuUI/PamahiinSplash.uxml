<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="project://database/Assets/MainMenuUI/PamahiinSplash.uss" />
    
    <ui:VisualElement class="screen" style="flex-grow: 1;">
        
        <!-- Background Ambient Elements -->
        <ui:VisualElement class="ring ring-outer" />
        <ui:VisualElement class="ring ring-middle" />
        <ui:VisualElement class="ring ring-inner" />
        <ui:VisualElement class="moon" />
        <ui:VisualElement name="mist1" class="mist mist-left" />
        <ui:VisualElement name="mist2" class="mist mist-right" />

        <!-- Border Frame -->
        <ui:VisualElement class="frame" picking-mode="Ignore">
            <ui:VisualElement class="corner corner-tl" />
            <ui:VisualElement class="corner corner-tr" />
            <ui:VisualElement class="corner corner-bl" />
            <ui:VisualElement class="corner corner-br" />
        </ui:VisualElement>

        <!-- VIEW 1: MAIN MENU -->
        <ui:VisualElement name="main-menu-view" class="content">
            <ui:Label text="&#10022;" class="glyph" />
            <ui:Label name="title" text="PAMAHIIN" class="title" />
            <ui:Label text="&#34;superstition&#34;" class="subtitle" />

            <ui:VisualElement class="menu">
                <ui:Button name="start-btn" text="HOST GAME" class="menu-btn primary" />
                <ui:Button name="join-menu-btn" text="JOIN GAME" class="menu-btn" />
                <ui:Button name="help-btn" text="HELP" class="menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- VIEW 2: HOST LOBBY -->
        <ui:VisualElement name="host-view" class="content hidden">
            <ui:Label text="HOST LOBBY" class="title" style="font-size: 32px; margin-bottom: 20px;" />
            <ui:Label text="WAITING FOR INVESTIGATORS..." class="subtitle" style="margin-bottom: 25px;" />
            
            <!-- Player Slots Container -->
            <ui:VisualElement class="slot-container">
                <ui:VisualElement class="player-slot"><ui:Label text="P1 [HOST]" class="slot-text" /></ui:VisualElement>
                <ui:VisualElement class="player-slot empty"><ui:Label text="WAITING..." class="slot-text" /></ui:VisualElement>
                <ui:VisualElement class="player-slot empty"><ui:Label text="WAITING..." class="slot-text" /></ui:VisualElement>
                <ui:VisualElement class="player-slot empty"><ui:Label text="WAITING..." class="slot-text" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="menu" style="margin-top: 30px;">
                <ui:Button name="launch-game-btn" text="START INVESTIGATION" class="menu-btn primary" />
                <ui:Button name="host-back-btn" text="BACK" class="menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- VIEW 3: JOIN LOBBY -->
        <ui:VisualElement name="join-view" class="content hidden">
            <ui:Label text="SERVER LIST" class="title" style="font-size: 32px; margin-bottom: 20px;" />
            
            <ui:VisualElement name="server-list-container" style="width: 400px; height: 180px; background-color: rgba(20,2,4,0.8); border-width: 1px; border-color: rgba(100,15,22,0.5); margin-bottom: 25px; padding: 10px;">
                <ui:Button name="discovered-server-btn" text="LOCAL LOBBY (HOST FOUND)" class="menu-btn" style="font-size: 12px; margin-bottom: 10px;" />
            </ui:VisualElement>

            <ui:VisualElement class="menu">
                <ui:Button name="join-back-btn" text="BACK" class="menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- VIEW 4: HELP / KEYBINDS -->
        <ui:VisualElement name="help-view" class="content hidden">
            <ui:Label text="FIELD MANUAL" class="title" style="font-size: 32px; margin-bottom: 15px;" />
            
            <ui:VisualElement style="width: 450px; background-color: rgba(15,2,3,0.85); border-width: 1px; border-color: rgba(80,10,15,0.6); padding: 15px; margin-bottom: 25px;">
                <ui:Label text="W A S D  -  Movement" class="keybind-text" />
                <ui:Label text="SHIFT  -  Run" class="keybind-text" />
                <ui:Label text="E  -  Interact (Doors / Objects)" class="keybind-text" />
                <ui:Label text="1 2 3  -  Inventory Slots" class="keybind-text" />
                <ui:Label text="G  -  Drop Item" class="keybind-text" />
                <ui:Label text="J  -  Open Journal" class="keybind-text" />
                <ui:Label text="ESC  -  Pause Game" class="keybind-text" />
            </ui:VisualElement>

            <ui:VisualElement class="menu">
                <ui:Button name="help-back-btn" text="BACK" class="menu-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>