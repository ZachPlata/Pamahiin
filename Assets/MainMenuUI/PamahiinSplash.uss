/* PamahiinSplash.uss
   Notes on what does NOT port 1:1 from CSS and what to do instead:
   - No radial-gradient / linear-gradient support in USS.
     -> .screen background is a flat colour here; for the moody gradient look,
        assign a background-image sprite (a soft radial PNG) in the Inspector,
        or drop in the pixel "bg-glow" sprite Claude can generate for you.
   - No clip-path support.
     -> .moon and .peaks (castle silhouette) must be actual sprite images
        (transparent PNGs) rather than CSS shapes. Assign via
        background-image once you have the art, or ask for the sprites.
   - No box-shadow / inset shadow.
     -> .vignette should be a PNG with a transparent centre and dark edges,
        stretched over the whole screen, OR skip it — UI Toolkit cameras
        usually don't need a manual vignette if your Camera/Volume already
        has one via post-processing.
   - No @keyframes / CSS animation.
     -> .title glow flicker, .bat flapping, .mist drifting all need a small
        C# script driving style values every frame or via
        experimental.animation. See PamahiinFlicker.cs.
   - Fonts: import "Press Start 2P" and "VT323" as .ttf into Assets/Fonts,
     then create a Font Asset (right-click > Create > UI Toolkit > Font
     Asset) and reference it below via -unity-font-definition.
*/

.screen {
    width: 100%;
    height: 100%;
    background-color: rgb(6, 1, 2);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.moon {
    position: absolute;
    top: 60px;
    left: 50%;
    width: 96px;
    height: 96px;
    margin-left: -48px;
    background-color: rgb(180, 18, 26);
    /* replace with background-image: sprite for the pixelated moon shape */
}

.bat-layer {
    position: absolute;
    width: 100%;
    height: 100%;
}

.bat {
    position: absolute;
    width: 10px;
    height: 6px;
    background-color: rgb(13, 3, 4);
    opacity: 0.85;
    /* replace with a small bat sprite for the wing silhouette */
}

.mist {
    position: absolute;
    opacity: 0.5;
    border-radius: 999px;
}

.mist-1 {
    width: 700px;
    height: 260px;
    background-color: rgb(28, 3, 6);
    bottom: 60px;
    left: 5%;
}

.mist-2 {
    width: 600px;
    height: 220px;
    background-color: rgb(42, 5, 9);
    bottom: 40px;
    right: 0%;
}

.peaks {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 140px;
    background-color: rgb(10, 2, 3);
    /* replace with the jagged castle-silhouette sprite */
}

.frame {
    position: absolute;
    top: 20px;
    right: 20px;
    bottom: 20px;
    left: 20px;
    border-width: 4px;
    border-color: rgb(74, 12, 16);
}

.corner {
    position: absolute;
    width: 10px;
    height: 10px;
    background-color: rgb(180, 18, 26);
    rotate: 45deg;
}

.corner-tl { top: 12px; left: 12px; }
.corner-tr { top: 12px; right: 12px; }
.corner-bl { bottom: 12px; left: 12px; }
.corner-br { bottom: 12px; right: 12px; }

.content {
    align-items: center;
    margin-top: 40px;
}

.glyph {
    font-size: 20px;
    color: rgb(180, 18, 26);
    margin-bottom: 14px;
    -unity-font-definition: url("project://database/Assets/Fonts/VT323-Regular.ttf");
}

.title {
    font-size: 44px;
    letter-spacing: 6px;
    color: rgb(230, 57, 70);
    -unity-font-definition: url("project://database/Assets/Fonts/PressStart2P-Regular.ttf");
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(58, 5, 8);
    /* the layered blur glow needs PamahiinFlicker.cs pulsing a TextShadow
       or a duplicate blurred label behind this one */
}

.subtitle {
    font-size: 24px;
    color: rgb(138, 80, 88);
    letter-spacing: 3px;
    margin-top: 12px;
    -unity-font-style: italic;
    -unity-font-definition: url("project://database/Assets/Fonts/VT323-Regular.ttf");
}

.menu {
    align-items: center;
    margin-top: 42px;
}

.menu-item {
    font-size: 15px;
    color: rgb(230, 57, 70);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    letter-spacing: 3px;
    margin-bottom: 20px;
    -unity-font-definition: url("project://database/Assets/Fonts/PressStart2P-Regular.ttf");
    transition-property: color;
    transition-duration: 0.15s;
}

.menu-item:hover {
    color: rgb(255, 107, 116);
}

.menu-item.primary {
    font-size: 17px;
}

.vignette {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* assign a soft dark-edged transparent-centre PNG here */
}
a